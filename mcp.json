{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash-ai/context7-mcp"],
      "type": "stdio"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"],
      "type": "stdio"
    },
    "watermelon": {
      "type": "http",
      "url": "https://mcp.watermelon.sh/mcp"
    }
  }
}
