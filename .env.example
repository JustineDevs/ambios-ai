# Development-only compatibility flag. The canonical frontend is Next.js and the
# backend is Hono; authenticated flows require a real server-side session.
AUTH_DISABLE=false

# Sage guardrails must be explicitly enabled in a configured deployment; absent/false fails closed.
SAGE_ENABLED=true

# Supabase project JWT secret; server-only, used to sign short-lived realtime capability tokens
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Worker-side Supabase Auth verification. Keep these available to both local
# Wrangler processes; the Worker never trusts an Authorization header by itself.
SUPABASE_ANON_KEY=

# Nango backend secret; never expose to the browser
NANGO_SECRET_KEY=
NEXT_PUBLIC_NANGO_PUBLIC_KEY=
NANGO_WEBHOOK_SECRET=
NANGO_HOST=https://api.nango.dev

# Remote MCP app connection for ChatGPT and other compatible clients.
# Submit this exact Core Worker MCP resource URL. It is the protected resource;
# Vercel hosts only the browser consent UI.
MCP_SERVER_URL=https://ambios-ai.pcg0255.workers.dev/mcp
MCP_RESOURCE_URL=https://ambios-ai.pcg0255.workers.dev/mcp
MCP_AUTHORIZATION_SERVER_URL=https://ambios-ai.pcg0255.workers.dev
MCP_AUTHORIZATION_ENDPOINT=https://ambios-ai.pcg0255.workers.dev/authorize
MCP_AUTH_UI_URL=https://ambios-ai.vercel.app/mcp/authorize
MCP_TOKEN_ENDPOINT=https://ambios-ai.pcg0255.workers.dev/token
MCP_RESOURCE_METADATA_URL=https://ambios-ai.pcg0255.workers.dev/.well-known/oauth-protected-resource
# OAuth credential issuance and consent are deployed on the authorization
# server. Introspection is optional for this opaque-token D1-backed issuer;
# leave these blank unless a separate introspection service is configured.
MCP_REQUIRED_SCOPE=ambios.workspace.read ambios.incidents.read ambios.tools.read
MCP_TOKEN_INTROSPECTION_URL=
MCP_TOKEN_INTROSPECTION_CLIENT_ID=
MCP_TOKEN_INTROSPECTION_CLIENT_SECRET=
OPENAI_APPS_CHALLENGE_TOKEN=

# Server-only provider credentials; never expose these in the browser.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_GZIP_LIMIT_MIB=3

# Cloudflare binding names are configured in wrangler.toml
AMBIOS_D1_DATABASE_ID=
AMBIOS_KV_NAMESPACE_ID=
AMBIOS_R2_BUCKET_NAME=ambios-ai-assets
AMBIOS_QUEUE_NAME=ambios-ai-jobs

# Google OAuth client credentials (configure the Google provider in Supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Xendit payment credentials
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_URL=https://api.xendit.co

# Resend email service
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Slack Chat SDK
SLACK_SIGNING_SECRET=
BOT_USERNAME=ambios
