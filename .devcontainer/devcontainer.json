{
  "name": "ambios-ai",
  "dockerComposeFile": ["..-ai/docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "devcontainer",
  "workspaceFolder": "-ai/workspaces-ai/ambios-ai",
  "features": {},
  "runServices": ["devcontainer", "kong", "web", "db"],
  "forwardPorts": [8000, 8001, 3001, 5432],
  "postCreateCommand": "corepack enable && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
